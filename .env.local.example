# ─────────────────────────────────────────────────────────────────────
# Loom Originals — plantilla de variables de entorno.
# Copia este archivo a .env.local y rellena con valores REALES.
#   cp .env.local.example .env.local
# .env.local está en .gitignore — NUNCA lo subas al repo.
# Las mismas variables deben configurarse en Vercel (Production + Preview);
# ver scripts/vercel-env-push.sh.
# ─────────────────────────────────────────────────────────────────────

# ── Obligatorias (la app no funciona con datos sin ellas) ────────────

# URL pública del sitio (sin slash final). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://loomsoriginal.com

# Supabase → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Settings → API → "anon public" key (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Settings → API → "service_role" secret key.
# SECRETO: acceso admin total, salta RLS. Solo server-side / scripts.
# Nunca con prefijo NEXT_PUBLIC_ y nunca hardcodeada en código.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lista separada por comas de emails con acceso al panel /admin
ADMIN_EMAILS=alguien@manuelsolis.com,otro@manuelsolis.com

# ── Opcionales (analítica y verificación; la app corre sin ellas) ────

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID (sdkid)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Search Console — token de verificación por meta tag
NEXT_PUBLIC_GSC_VERIFICATION=

# YouTube Data API v3 key (Google Cloud Console, con la API v3 habilitada).
# La usa la ingesta scripts/ingest-youtube.py para descubrir el canal y traer
# metadata. Opcional para la app web; requerida para correr la ingesta.
YOUTUBE_API_KEY=

# ── Scripts de datos en scripts/ (ingesta) ──────────────────────────
# ID del canal de YouTube a ingerir (formato UC..., NO el handle @nombre).
# Lo usa scripts/ingest-youtube.py para descubrir todos los uploads.
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Los scripts Python reutilizan SUPABASE_SERVICE_ROLE_KEY (arriba) y la URL
# de Supabase. Para la URL aceptan, en este orden: SUPABASE_URL si está
# definida, si no NEXT_PUBLIC_SUPABASE_URL. Normalmente NO necesitas definir
# SUPABASE_URL por separado; descoméntala solo si quieres apuntar los scripts
# a un proyecto distinto del de la app.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
